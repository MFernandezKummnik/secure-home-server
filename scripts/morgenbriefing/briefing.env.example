# Kopie als /mnt/user/appdata/morgenbriefing/briefing.env anlegen (root:root, chmod 600, nie ins Repo)

# Radicale (gleiche Adresse/Zugangsdaten wie auf dem iPhone)
RADICALE_URL=http://127.0.0.1:5232/
RADICALE_USER=miguel
RADICALE_PASSWORD=

# Matrix (Token und Raum-ID aus der Einrichtung im README)
# 127.0.0.1 funktioniert, weil der Container mit --network host läuft
MATRIX_HOMESERVER=http://127.0.0.1:8008
MATRIX_TOKEN=
MATRIX_RAUM_ID=!xxxxxxxx:SERVERNAME

# Wetter: Stockach
BREITE=47.851
LAENGE=9.008

# Titelwörter, an denen eine Abgabe erkannt wird (Groß-/Kleinschreibung egal).
# Leer lassen = alle Termine der nächsten 7 Tage anzeigen.
ABGABE_WORTE=Abgabe,Deadline,Frist,Klausur,Prüfung

# Ordner der Zeitung IM Container (siehe -v im User Script); leer = nur Hinweis ohne Prüfung
ZEITUNG_ORDNER=/zeitung

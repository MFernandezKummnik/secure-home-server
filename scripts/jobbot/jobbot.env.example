# Copy to /mnt/user/appdata/jobbot/jobbot.env, fill in, then: chmod 600 jobbot.env
# No quotes, no spaces around "=", no trailing spaces.
# IMAP_PASS is the Gmail app password of the bot account, without the spaces Google shows.
IMAP_USER=
IMAP_PASS=
MATRIX_HS=http://127.0.0.1:8008
MATRIX_TOKEN=
MATRIX_ROOM=
